# ── AI (선택) ─────────────────────────────────────────
# 없으면 사진 분석 단계가 "대표색 자동 추출 + 칩 선택"으로 대체됩니다.
ANTHROPIC_API_KEY=
# 옷 태깅용 기본 모델 (저비용). 더 정확한 분석이 필요하면 claude-sonnet-5
ANTHROPIC_VISION_MODEL=claude-haiku-4-5-20251001

# ── AI TRY-ON (선택) ──────────────────────────────────
# 없으면 Outfit Builder는 2D 룩북만 보여주고 "AI 착용은 GEMINI_API_KEY 설정 필요" 안내가 뜹니다.
# 발급: https://aistudio.google.com/apikey · 이 모델은 무료 티어가 없어 결제(유료 티어)가 연결된 키가 필요합니다.
GEMINI_API_KEY=
# 착용 이미지 모델. 기본 gemini-3.1-flash-image (1K 이미지 1장 ≈ $0.067 + 입력).
# gemini-2.5-flash-image 는 2026-10-02 종료 — 쓰지 마세요.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── Supabase (선택) ───────────────────────────────────
# 없으면 브라우저 IndexedDB에 저장됩니다 (기기별 로컬 옷장).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
